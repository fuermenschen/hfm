#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="$ROOT_DIR/docker-compose.upgrade-lab.yml"

TARGET_COMMIT=""
DUMP_PATH=""
DUMP_PATH_ABS=""
BASELINE_COMMIT="main"
RUN_ID="$(date +%Y%m%d%H%M%S)"
KEEP_RUNNING=0
NO_INTERACTION=0
MANUAL_GATE_BLOCKERS=""

usage() {
    cat <<'EOF'
Usage:
  scripts/upgrade-lab --target=<sha-or-branch> --dump-path=<path> [options]

Required:
  --target        Target revision to rehearse after baseline
  --dump-path     SQL dump path

Options:
  --baseline      Baseline revision to rehearse first (default: main)
  --run-id        Run identifier for project, volume, and report paths
  --no-interaction  Skip interactive pauses and auto-pass all checklists
  --keep-running  Keep containers and worktree after completion
  --commit        Alias for --target (kept for compatibility)
  --help          Show this help

Notes:
  - Reports are written to storage/upgrade-lab/reports/<run-id>/.
  - Dump source is mandatory; seed mode is intentionally disabled.
  - Target deploy mirrors production: down, migrate, storage:link, optimize, up.
  - The script always pauses after baseline checks and after deploy for
    manual verification. Use --no-interaction to skip pauses and auto-pass
    checklists (useful for automated testing).
  - Release-specific commands (backfills, data migrations) are run manually
    on the container during the post-deploy pause.
  - Mail is routed to Mailpit in the lab stack for login-link checks.
  - Uses docker compose directly.
EOF
}

fail() {
    printf 'ERROR: %s\n' "$1" >&2
    exit 1
}

is_absolute_path() {
    local path="$1"

    if [[ "$path" == /* ]]; then
        return 0
    fi

    if [[ "$path" =~ ^[A-Za-z]:[\\/].* ]]; then
        return 0
    fi

    return 1
}

resolve_path() {
    local path="$1"

    if is_absolute_path "$path"; then
        printf '%s' "$path"
        return
    fi

    printf '%s/%s' "$ROOT_DIR" "$path"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --target=*) TARGET_COMMIT="${1#*=}" ;;
        --commit=*) TARGET_COMMIT="${1#*=}" ;;
        --dump-path=*) DUMP_PATH="${1#*=}" ;;
        --baseline=*) BASELINE_COMMIT="${1#*=}" ;;
        --run-id=*) RUN_ID="${1#*=}" ;;
        --no-interaction) NO_INTERACTION=1 ;;
        --keep-running) KEEP_RUNNING=1 ;;
        --help) usage; exit 0 ;;
        *) fail "Unknown option: $1" ;;
    esac

    shift
done

[[ -n "$TARGET_COMMIT" ]] || fail "--target (or --commit alias) is required"

[[ -n "$DUMP_PATH" ]] || fail "--dump-path is required"
DUMP_PATH_ABS="$(resolve_path "$DUMP_PATH")"
[[ -f "$DUMP_PATH_ABS" ]] || fail "Dump file not found: $DUMP_PATH_ABS"
[[ -r "$DUMP_PATH_ABS" ]] || fail "Dump file is not readable: $DUMP_PATH_ABS"

command -v git >/dev/null || fail "git is required"
command -v docker >/dev/null || fail "docker is required"

git -C "$ROOT_DIR" rev-parse --verify "$TARGET_COMMIT^{commit}" >/dev/null 2>&1 || fail "Cannot resolve commit: $TARGET_COMMIT"
git -C "$ROOT_DIR" rev-parse --verify "$BASELINE_COMMIT^{commit}" >/dev/null 2>&1 || fail "Cannot resolve baseline: $BASELINE_COMMIT"

TARGET_COMMIT_SHA="$(git -C "$ROOT_DIR" rev-parse --verify "$TARGET_COMMIT^{commit}")"
BASELINE_COMMIT_SHA="$(git -C "$ROOT_DIR" rev-parse --verify "$BASELINE_COMMIT^{commit}")"

WORKTREE_DIR="$ROOT_DIR/.upgrade-lab/worktrees/$RUN_ID"
REPORT_DIR="$ROOT_DIR/storage/upgrade-lab/reports/$RUN_ID"
REPORT_FILE="$REPORT_DIR/report.md"

BASELINE_PHP_EXTENSIONS_FILE="$REPORT_DIR/baseline-php-extensions.txt"
BASELINE_APACHE_MODULES_FILE="$REPORT_DIR/baseline-apache-modules.txt"
BASELINE_DB_SETTINGS_FILE="$REPORT_DIR/baseline-db-settings.txt"
TARGET_PHP_EXTENSIONS_FILE="$REPORT_DIR/target-php-extensions.txt"
TARGET_APACHE_MODULES_FILE="$REPORT_DIR/target-apache-modules.txt"
TARGET_DB_SETTINGS_FILE="$REPORT_DIR/target-db-settings.txt"

mkdir -p "$REPORT_DIR"

git -C "$ROOT_DIR" worktree prune

export UPGRADE_LAB_PROJECT_NAME="hfm-upgrade-$RUN_ID"
export UPGRADE_LAB_APP_SOURCE="$WORKTREE_DIR"
export UPGRADE_LAB_DB_VOLUME="hfm-upgrade-db-$RUN_ID"
export UPGRADE_LAB_APP_PORT="${UPGRADE_LAB_APP_PORT:-18080}"
export UPGRADE_LAB_DB_PORT="${UPGRADE_LAB_DB_PORT:-13306}"
export UPGRADE_LAB_DB_DATABASE="${UPGRADE_LAB_DB_DATABASE:-hfm_upgrade_lab}"
export UPGRADE_LAB_DB_USERNAME="${UPGRADE_LAB_DB_USERNAME:-hfm}"
export UPGRADE_LAB_DB_PASSWORD="${UPGRADE_LAB_DB_PASSWORD:-hfm_password}"
export UPGRADE_LAB_DB_ROOT_PASSWORD="${UPGRADE_LAB_DB_ROOT_PASSWORD:-root_password}"
export UPGRADE_LAB_MAILPIT_IMAGE="${UPGRADE_LAB_MAILPIT_IMAGE:-axllent/mailpit:latest}"
export UPGRADE_LAB_MAILPIT_SMTP_PORT="${UPGRADE_LAB_MAILPIT_SMTP_PORT:-11025}"
export UPGRADE_LAB_MAILPIT_UI_PORT="${UPGRADE_LAB_MAILPIT_UI_PORT:-18025}"
export COMPOSE_PROJECT_NAME="$UPGRADE_LAB_PROJECT_NAME"

MAILPIT_UI_URL="http://localhost:$UPGRADE_LAB_MAILPIT_UI_PORT"

compose_cmd() {
    docker compose --project-name "$UPGRADE_LAB_PROJECT_NAME" -f "$COMPOSE_FILE" "$@"
}

cleanup() {
    if [[ "$KEEP_RUNNING" -eq 0 ]]; then
        compose_cmd down --volumes --remove-orphans >/dev/null 2>&1 || true
        git -C "$ROOT_DIR" worktree remove --force "$WORKTREE_DIR" >/dev/null 2>&1 || true
    fi
}

run_dump_setup() {
    local reset_sql

    printf 'Importing dump for phase from %s\n' "$DUMP_PATH_ABS"

    compose_cmd exec -T db sh -lc 'cat > /tmp/upgrade-lab-dump.sql' < "$DUMP_PATH_ABS"

    reset_sql="DROP DATABASE IF EXISTS \`$UPGRADE_LAB_DB_DATABASE\`; CREATE DATABASE \`$UPGRADE_LAB_DB_DATABASE\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
    compose_cmd exec -T db mariadb --user=root --password="$UPGRADE_LAB_DB_ROOT_PASSWORD" --execute "$reset_sql"
    compose_cmd exec -T db sh -lc "mariadb --user='$UPGRADE_LAB_DB_USERNAME' --password='$UPGRADE_LAB_DB_PASSWORD' '$UPGRADE_LAB_DB_DATABASE' < /tmp/upgrade-lab-dump.sql"
    compose_cmd exec -T db rm -f /tmp/upgrade-lab-dump.sql

    compose_cmd exec -T app php artisan migrate --no-interaction
}

wait_for_app() {
    local max_attempts=60
    local attempt=0

    printf 'Waiting for app container to accept commands...\n'

    while [[ $attempt -lt $max_attempts ]]; do
        if compose_cmd exec -T app true >/dev/null 2>&1; then
            printf 'App container ready.\n'
            return 0
        fi

        attempt=$((attempt + 1))
        sleep 2
    done

    fail "Timed out waiting for app container after $((max_attempts * 2))s"
}

prepare_worktree_runtime_artifacts() {
    compose_cmd exec -T app composer install --no-interaction --prefer-dist --optimize-autoloader

    if compose_cmd exec -T app test -f package-lock.json; then
        compose_cmd exec -T app npm ci
    else
        compose_cmd exec -T app npm install
    fi

    compose_cmd exec -T app npm run build
}

run_target_deploy() {
    local migrate_log

    migrate_log="$REPORT_DIR/target-migrate.log"

    compose_cmd exec -T app php artisan migrate --no-interaction | tee "$migrate_log"
    compose_cmd exec -T app php artisan storage:link --no-interaction
    compose_cmd exec -T app php artisan optimize
    compose_cmd exec -T app php artisan up --no-interaction
}

collect_db_version() {
    compose_cmd exec -T db mariadb --user="$UPGRADE_LAB_DB_USERNAME" --password="$UPGRADE_LAB_DB_PASSWORD" --execute='SELECT VERSION();' | sed -n '2p'
}

collect_http_status() {
    compose_cmd exec -T app php -r '$headers = @get_headers("http://localhost/"); echo $headers[0] ?? "NO_RESPONSE";'
}

collect_mailpit_status() {
    compose_cmd exec -T app php -r '$body = @file_get_contents("http://mailpit:8025/api/v1/messages"); if ($body === false) { fwrite(STDERR, "mailpit unreachable"); exit(2); } $data = json_decode($body, true); if (! is_array($data)) { fwrite(STDERR, "mailpit invalid response"); exit(3); } $total = $data["total"] ?? (isset($data["messages"]) && is_array($data["messages"]) ? count($data["messages"]) : "unknown"); echo "reachable,total=".$total;'
}

collect_phase_parity_artifacts() {
    local phase="$1"
    local php_extensions_file apache_modules_file db_settings_file

    case "$phase" in
        baseline)
            php_extensions_file="$BASELINE_PHP_EXTENSIONS_FILE"
            apache_modules_file="$BASELINE_APACHE_MODULES_FILE"
            db_settings_file="$BASELINE_DB_SETTINGS_FILE"
            ;;
        target)
            php_extensions_file="$TARGET_PHP_EXTENSIONS_FILE"
            apache_modules_file="$TARGET_APACHE_MODULES_FILE"
            db_settings_file="$TARGET_DB_SETTINGS_FILE"
            ;;
        *)
            fail "Unknown parity phase: $phase"
            ;;
    esac

    compose_cmd exec -T app php -m | sort > "$php_extensions_file"
    compose_cmd exec -T app sh -lc 'apache2ctl -M 2>/dev/null' | sort > "$apache_modules_file"
    compose_cmd exec -T db mariadb \
        --user="$UPGRADE_LAB_DB_USERNAME" \
        --password="$UPGRADE_LAB_DB_PASSWORD" \
        --batch --skip-column-names \
        --execute='SELECT "sql_mode", @@sql_mode UNION ALL SELECT "character_set_server", @@character_set_server UNION ALL SELECT "collation_server", @@collation_server UNION ALL SELECT "time_zone", @@time_zone UNION ALL SELECT "system_time_zone", @@system_time_zone;' \
        > "$db_settings_file"
}

append_gate_blocker() {
    local message="$1"

    if [[ -z "$MANUAL_GATE_BLOCKERS" ]]; then
        MANUAL_GATE_BLOCKERS="$message"
        return
    fi

    MANUAL_GATE_BLOCKERS+=$'\n'
    MANUAL_GATE_BLOCKERS+="$message"
}

normalize_check_status() {
    local status="$1"

    status="${status#${status%%[![:space:]]*}}"
    status="${status%${status##*[![:space:]]}}"
    status="${status,,}"

    printf '%s' "$status"
}

check_label() {
    case "$1" in
        public_pages) printf 'Public pages render correctly' ;;
        faq) printf 'FAQ page content (/fragen-und-antworten)' ;;
        registration_guards) printf 'Registration guards' ;;
        mailpit_email) printf 'Login-link email received in Mailpit' ;;
        admin_pages) printf 'Admin pages load correctly (/admin)' ;;
        logs) printf 'Logs clean (no critical errors)' ;;
        *) printf '%s' "$1" ;;
    esac
}

collect_phase_checklist() {
    local prefix="$1"
    local phase_label="$2"
    local notes=""
    local key status input
    local keys=(public_pages faq registration_guards mailpit_email admin_pages logs)

    for key in "${keys[@]}"; do
        printf -v "${prefix}_${key}" '%s' ""
    done
    printf -v "${prefix}_notes" '%s' ""

    if [[ "$NO_INTERACTION" -eq 1 ]]; then
        for key in "${keys[@]}"; do
            printf -v "${prefix}_${key}" '%s' "pass"
        done
        printf -v "${prefix}_notes" '%s' "auto-passed (--no-interaction)"
        return
    fi

    printf '%s checklist\n' "$phase_label"
    printf 'Use pass/fail for each check.\n'

    for key in "${keys[@]}"; do
        while true; do
            printf '%s: ' "$(check_label "$key")"
            read -r input
            status="$(normalize_check_status "$input")"

            if [[ "$status" == "pass" || "$status" == "fail" ]]; then
                printf -v "${prefix}_${key}" '%s' "$status"
                break
            fi

            printf 'Please enter pass or fail.\n'
        done
    done

    printf 'Notes (optional): '
    read -r notes
    printf -v "${prefix}_notes" '%s' "$notes"

    for key in "${keys[@]}"; do
        local status_var="${prefix}_${key}"
        status="${!status_var:-}"
        status="$(normalize_check_status "$status")"

        if [[ "$status" != "pass" && "$status" != "fail" ]]; then
            fail "$phase_label checklist missing or invalid value for '$key'. Allowed: pass|fail"
        fi

        printf -v "${prefix}_${key}" '%s' "$status"
    done
}

report_checklist_section() {
    local prefix="$1"
    local phase_label="$2"
    local notes_var="${prefix}_notes"
    local public_pages_var="${prefix}_public_pages"
    local faq_var="${prefix}_faq"
    local registration_var="${prefix}_registration_guards"
    local mailpit_var="${prefix}_mailpit_email"
    local admin_pages_var="${prefix}_admin_pages"
    local logs_var="${prefix}_logs"

    {
        echo "### Checklist ($phase_label)"
        echo
        echo "- Public pages render correctly: ${!public_pages_var}"
        echo "- FAQ page content (/fragen-und-antworten): ${!faq_var}"
        echo "- Registration guards: ${!registration_var}"
        echo "- Login-link email received in Mailpit: ${!mailpit_var}"
        echo "- Admin pages load correctly (/admin): ${!admin_pages_var}"
        echo "- Logs clean (no critical errors): ${!logs_var}"

        if [[ -n "${!notes_var}" ]]; then
            echo "- Notes: ${!notes_var}"
        fi

        echo
    } >> "$REPORT_FILE"
}

evaluate_checklist_gate() {
    local prefix="$1"
    local phase_label="$2"
    local key
    local keys=(public_pages faq registration_guards mailpit_email admin_pages logs)

    for key in "${keys[@]}"; do
        local status_var="${prefix}_${key}"

        if [[ "${!status_var}" != "pass" ]]; then
            append_gate_blocker "$phase_label checklist failed: $(check_label "$key")"
        fi
    done
}

trap cleanup EXIT

if [[ -e "$WORKTREE_DIR" ]]; then
    fail "Worktree path already exists: $WORKTREE_DIR"
fi

git -C "$ROOT_DIR" worktree add --detach "$WORKTREE_DIR" "$BASELINE_COMMIT_SHA" >/dev/null

if [[ ! -f "$WORKTREE_DIR/.env" ]]; then
    cp "$WORKTREE_DIR/.env.example" "$WORKTREE_DIR/.env"
fi

if [[ -f "$ROOT_DIR/auth.json" ]]; then
    cp "$ROOT_DIR/auth.json" "$WORKTREE_DIR/auth.json"
fi

{
    echo "# Upgrade Lab Report"
    echo
    echo "- Run ID: $RUN_ID"
    echo "- Baseline commit: $BASELINE_COMMIT ($BASELINE_COMMIT_SHA)"
    echo "- Target commit: $TARGET_COMMIT ($TARGET_COMMIT_SHA)"
    echo "- Data source: dump"
    echo "- Dump path: $DUMP_PATH_ABS"
    echo "- No-interaction mode: $NO_INTERACTION"
    echo "- App source path: $WORKTREE_DIR"
    echo
} > "$REPORT_FILE"

compose_cmd up --detach --build

wait_for_app

prepare_worktree_runtime_artifacts

compose_cmd exec -T app php artisan key:generate --force --no-interaction

compose_cmd exec -T app php artisan down --no-interaction

compose_cmd exec -T app php artisan about

APP_URL="http://localhost:$UPGRADE_LAB_APP_PORT"

printf '\n=== URLs ===\n'
printf '  App:       %s/\n' "$APP_URL"
printf '  Admin:     %s/admin\n' "$APP_URL"
printf '  FAQ:       %s/fragen-und-antworten\n' "$APP_URL"
printf '  Mailpit UI: %s\n' "$MAILPIT_UI_URL"
printf '  Mailpit SMTP: localhost:%s\n' "$UPGRADE_LAB_MAILPIT_SMTP_PORT"
printf '  DB:        localhost:%s\n\n' "$UPGRADE_LAB_DB_PORT"

run_dump_setup

compose_cmd exec -T app php artisan up --no-interaction

BASELINE_PHP_VERSION="$(compose_cmd exec -T app php -v | head -n 1)"
BASELINE_APACHE_VERSION="$(compose_cmd exec -T app apache2 -v | sed -n '1p')"
BASELINE_DB_VERSION="$(collect_db_version)"
BASELINE_HTTP_STATUS="$(collect_http_status)"
BASELINE_MAILPIT_STATUS="$(collect_mailpit_status)"
collect_phase_parity_artifacts "baseline"

{
    echo "## Baseline phase"
    echo
    echo "- Checked revision: $BASELINE_COMMIT"
    echo
    echo "### Runtime snapshot"
    echo
    echo "- PHP: $BASELINE_PHP_VERSION"
    echo "- Apache: $BASELINE_APACHE_VERSION"
    echo "- MariaDB: $BASELINE_DB_VERSION"
    echo "- HTTP / status: $BASELINE_HTTP_STATUS"
    echo
    echo "### Runtime parity artifacts"
    echo
    echo "- PHP extensions snapshot: $BASELINE_PHP_EXTENSIONS_FILE"
    echo "- Apache modules snapshot: $BASELINE_APACHE_MODULES_FILE"
    echo "- Database settings snapshot: $BASELINE_DB_SETTINGS_FILE"
    echo
    echo "### Mail capture"
    echo
    echo "- SMTP endpoint: localhost:$UPGRADE_LAB_MAILPIT_SMTP_PORT"
    echo "- Mailpit UI: $MAILPIT_UI_URL"
    echo "- Mailpit API check: $BASELINE_MAILPIT_STATUS"
    echo "- Manual verification: trigger a login-link email and confirm it appears in Mailpit UI."
    echo
} >> "$REPORT_FILE"

if [[ "$BASELINE_HTTP_STATUS" != *"200"* ]]; then
    append_gate_blocker "Baseline HTTP smoke failed for '/' (status: $BASELINE_HTTP_STATUS)"
fi

collect_phase_checklist "BASELINE" "Baseline"
report_checklist_section "BASELINE" "baseline"
evaluate_checklist_gate "BASELINE" "Baseline"

if [[ "$NO_INTERACTION" -eq 0 ]]; then
    printf '\n=== Baseline phase complete ===\n'
    printf '  App:       %s/\n' "$APP_URL"
    printf '  Admin:     %s/admin\n' "$APP_URL"
    printf '  FAQ:       %s/fragen-und-antworten\n' "$APP_URL"
    printf '  Mailpit:   %s\n' "$MAILPIT_UI_URL"
    printf '  DB:        localhost:%s\n\n' "$UPGRADE_LAB_DB_PORT"
    printf 'Press Enter to continue with target phase...\n'
    read -r _
fi

compose_cmd exec -T app php artisan down --no-interaction

git -C "$WORKTREE_DIR" checkout --detach "$TARGET_COMMIT_SHA" >/dev/null

prepare_worktree_runtime_artifacts

compose_cmd exec -T app php artisan about
run_target_deploy

if [[ "$NO_INTERACTION" -eq 0 ]]; then
    printf '\n=== Target deploy complete — run manual commands ===\n'
    printf '  App:       %s/\n' "$APP_URL"
    printf '  Admin:     %s/admin\n' "$APP_URL"
    printf '  Mailpit:   %s\n' "$MAILPIT_UI_URL"
    printf '  Container: docker exec -it %s-app-1 bash\n' "$UPGRADE_LAB_PROJECT_NAME"
    printf '\n'
    printf '  Run any release-specific commands (backfills, data migrations)\n'
    printf '  directly on the container now. This step is optional.\n'
    printf '\n'
    printf 'Press Enter to proceed with upgrade checks...\n'
    read -r _
fi

TARGET_PHP_VERSION="$(compose_cmd exec -T app php -v | head -n 1)"
TARGET_APACHE_VERSION="$(compose_cmd exec -T app apache2 -v | sed -n '1p')"
TARGET_DB_VERSION="$(collect_db_version)"
TARGET_HTTP_STATUS="$(collect_http_status)"
TARGET_MAILPIT_STATUS="$(collect_mailpit_status)"
collect_phase_parity_artifacts "target"

{
    echo "### Upgrade execution"
    echo
    echo "- Deploy steps: down, migrate, storage:link, optimize, up"
    echo "- Migrate log: $REPORT_DIR/target-migrate.log"
    echo
} >> "$REPORT_FILE"

{
    echo "## Target phase"
    echo
    echo "- Checked revision: $TARGET_COMMIT"
    echo
    echo "### Runtime snapshot"
    echo
    echo "- PHP: $TARGET_PHP_VERSION"
    echo "- Apache: $TARGET_APACHE_VERSION"
    echo "- MariaDB: $TARGET_DB_VERSION"
    echo "- HTTP / status: $TARGET_HTTP_STATUS"
    echo
    echo "### Runtime parity artifacts"
    echo
    echo "- PHP extensions snapshot: $TARGET_PHP_EXTENSIONS_FILE"
    echo "- Apache modules snapshot: $TARGET_APACHE_MODULES_FILE"
    echo "- Database settings snapshot: $TARGET_DB_SETTINGS_FILE"
    echo
    echo "### Mail capture"
    echo
    echo "- SMTP endpoint: localhost:$UPGRADE_LAB_MAILPIT_SMTP_PORT"
    echo "- Mailpit UI: $MAILPIT_UI_URL"
    echo "- Mailpit API check: $TARGET_MAILPIT_STATUS"
    echo "- Manual verification: trigger a login-link email and confirm it appears in Mailpit UI."
    echo
} >> "$REPORT_FILE"

if [[ "$TARGET_HTTP_STATUS" != *"200"* ]]; then
    append_gate_blocker "Target HTTP smoke failed for '/' (status: $TARGET_HTTP_STATUS)"
fi

collect_phase_checklist "TARGET" "Target"
report_checklist_section "TARGET" "target"
evaluate_checklist_gate "TARGET" "Target"

{
    echo "## Comparison"
    echo
    echo "- Baseline HTTP status: $BASELINE_HTTP_STATUS"
    echo "- Target HTTP status: $TARGET_HTTP_STATUS"
    echo "- Baseline Mailpit check: $BASELINE_MAILPIT_STATUS"
    echo "- Target Mailpit check: $TARGET_MAILPIT_STATUS"
    echo
} >> "$REPORT_FILE"

GATE_STATUS="PASS"

if [[ -n "$MANUAL_GATE_BLOCKERS" ]]; then
    GATE_STATUS="FAIL"
fi

{
    echo "## Gate result"
    echo
    echo "- Status: $GATE_STATUS"

    if [[ "$GATE_STATUS" == "PASS" ]]; then
        echo "- Blockers: none"
    else
        echo "- Blockers:"
        while IFS= read -r blocker; do
            [[ -z "$blocker" ]] && continue
            echo "  - $blocker"
        done <<< "$MANUAL_GATE_BLOCKERS"
    fi

    echo
} >> "$REPORT_FILE"

if [[ "$GATE_STATUS" == "PASS" ]]; then
    printf 'Upgrade lab completed successfully. Report: %s\n' "$REPORT_FILE"
else
    printf 'Upgrade lab failed gate checks. Report: %s\n' "$REPORT_FILE"
fi

printf 'Mailpit UI is available at: %s\n' "$MAILPIT_UI_URL"

if [[ "$KEEP_RUNNING" -eq 1 ]]; then
    printf 'Environment kept running. Project: %s\n' "$UPGRADE_LAB_PROJECT_NAME"
fi

if [[ "$GATE_STATUS" != "PASS" ]]; then
    exit 1
fi
