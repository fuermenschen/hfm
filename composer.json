{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-zip": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "endroid/qr-code": "^6.1",
        "intervention/image": "^4.0",
        "laravel/framework": "^13.0",
        "laravel/prompts": "^0.3.14",
        "laravel/pulse": "^1.7",
        "laravel/tinker": "^3.0",
        "livewire/blaze": "^1.0",
        "livewire/flux": "^2.13",
        "livewire/flux-pro": "^2.13",
        "livewire/livewire": "^4.2",
        "opcodesio/log-viewer": "^3.23",
        "propaganistas/laravel-phone": "^6.0",
        "smalot/pdfparser": "^2.12",
        "spatie/laravel-honeypot": "^4.7",
        "spatie/laravel-settings": "^3.4",
        "spatie/simple-excel": "^3.9",
        "sprain/swiss-qr-bill": "^5.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.1",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.3",
        "laravel/pint": "^1.28",
        "laravel/sail": "^1.57",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.4",
        "spatie/laravel-ignition": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi",
            "@php -r \"if (file_exists('AGENTS.md')) { is_dir('.github') || mkdir('.github', 0777, true); copy('AGENTS.md', '.github/copilot-instructions.md'); }\""
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "precommit": [
            "vendor/bin/pint --dirty",
            "npm run build",
            "vendor/bin/phpstan",
            "php artisan test --parallel",
            "npm run e2e"
        ],
        "lint:ai": [
            "vendor/bin/pint --dirty -q"
        ],
        "test:sca:ai": [
            "vendor/bin/phpstan --error-format=json"
        ],
        "test:pest:ai": [
            "php artisan test --parallel --compact --colors=never"
        ],
        "test:e2e:ai": [
            "npm run e2e:ai"
        ],
        "precommit:ai": [
            "@lint:ai",
            "npm run build:ai",
            "@test:sca:ai",
            "@test:pest:ai",
            "@test:e2e:ai"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "flux-pro": {
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        }
    }
}
